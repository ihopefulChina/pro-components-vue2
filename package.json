{
  "name": "pro-components-vue2",
  "version": "1.0.0",
  "description": "基于Vue2+element-ui+Composition API+TypeScript的高质量组件库",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "start": "node start-dev.js",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.ts --fix",
    "lint:check": "eslint src --ext .vue,.js,.ts",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build:lib && npm run lint:check && npm run type-check",
    "release": "npm run build:lib && npm publish"
  },
  "keywords": [
    "vue2",
    "composition-api",
    "typescript",
    "components",
    "ui",
    "element-ui",
    "pro-components"
  ],
  "author": "ihopefulChina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihopefulChina/pro-components-vue2.git"
  },
  "bugs": {
    "url": "https://github.com/ihopefulChina/pro-components-vue2/issues"
  },
  "homepage": "https://github.com/ihopefulChina/pro-components-vue2#readme",
  "peerDependencies": {
    "@vue/composition-api": "^1.7.0",
    "element-ui": "^2.15.0",
    "vue": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue2": "^2.0.3",
    "@vue/composition-api": "^1.7.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^1.3.0",
    "@types/jest": "^29.0.0",
    "element-ui": "^2.15.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.60.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "vite-plugin-dts": "^3.0.0",
    "vite-plugin-lib-inject-css": "^1.3.0",
    "vitest": "^0.34.0",
    "vue": "^2.7.0",
    "vue-tsc": "^1.8.0"
  },
  "dependencies": {
    "lodash-es": "^4.17.0",
    "vite-plugin-vue2": "^2.0.3",
    "vuedraggable": "^2.24.3"
  }
}
